{
  "name": "data-examiner-app",
  "version": "3.0.0",
  "description": "Ultra-beautiful AI-powered data analysis PWA for CSV/Excel files with interactive chatbot",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore 'uploads/' server.js",
    "clean": "rm -rf node_modules uploads",
    "reset": "npm run clean && npm install",
    "setup": "npm install && mkdir -p uploads assets/icons assets/favicon assets/src",
    "generate-icons": "node scripts/generate-icons.js",
    "fix-permissions": "chmod -R 755 . && chmod 644 package.json",
    "test": "echo \"No tests specified\" && exit 0",
    "heroku-postbuild": "echo 'Build completed successfully'"
  },
  "keywords": [
    "ai",
    "data-analysis",
    "csv",
    "excel",
    "visualization",
    "groq",
    "chatbot",
    "pwa",
    "chartjs"
  ],
  "author": "Data Examiner Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "multer": "^2.0.0",
    "rate-limiter-flexible": "^2.4.2",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ebuka-martins/data-examiner-app.git"
  },
  "bugs": {
    "url": "https://github.com/Ebuka-martins/data-examiner-app/issues"
  },
  "homepage": "https://github.com/Ebuka-martins/data-examiner-app#readme"
}